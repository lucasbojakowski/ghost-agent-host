{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/schemas/mix_plan.schema.json",
  "title": "Ghost Mix Plan",
  "type": "object",
  "required": ["schema_version", "summary", "confidence", "assumptions", "operations", "expected_changes", "cautions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "ghost.mix-plan/1"},
    "summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["operation", "settings"],
            "additionalProperties": false,
            "properties": {
              "operation": {"const": "eq_band"},
              "settings": {
                "type": "object",
                "required": ["band_id", "enabled", "shape", "frequency_hz", "gain_db", "q", "channel_mode", "rationale", "evidence"],
                "additionalProperties": false,
                "properties": {
                  "band_id": {"type": "string"},
                  "enabled": {"type": "boolean"},
                  "shape": {"enum": ["bell", "low_shelf", "high_shelf", "low_cut", "high_cut", "notch"]},
                  "frequency_hz": {"type": "number", "minimum": 10, "maximum": 30000},
                  "gain_db": {"type": "number", "minimum": -18, "maximum": 18},
                  "q": {"type": "number", "minimum": 0.05, "maximum": 40},
                  "slope_db_oct": {"type": ["number", "null"]},
                  "channel_mode": {"type": "string"},
                  "dynamic": {
                    "oneOf": [
                      {"type": "null"},
                      {
                        "type": "object",
                        "required": ["enabled", "range_db", "threshold_db"],
                        "additionalProperties": false,
                        "properties": {
                          "enabled": {"type": "boolean"},
                          "range_db": {"type": "number", "minimum": -12, "maximum": 12},
                          "threshold_db": {"type": ["number", "null"]}
                        }
                      }
                    ]
                  },
                  "rationale": {"type": "string"},
                  "evidence": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["operation", "settings"],
            "additionalProperties": false,
            "properties": {
              "operation": {"const": "compressor"},
              "settings": {
                "type": "object",
                "required": ["enabled", "style", "threshold_db", "ratio", "knee_db", "attack_ms", "release_ms", "range_db", "mix_percent", "output_gain_db", "rationale", "evidence"],
                "additionalProperties": false,
                "properties": {
                  "enabled": {"type": "boolean"},
                  "style": {"type": "string"},
                  "threshold_db": {"type": "number", "minimum": -80, "maximum": 12},
                  "ratio": {"type": "number", "minimum": 1, "maximum": 100},
                  "knee_db": {"type": "number", "minimum": 0, "maximum": 72},
                  "attack_ms": {"type": "number", "minimum": 0.005, "maximum": 2000},
                  "release_ms": {"type": "number", "minimum": 1, "maximum": 10000},
                  "range_db": {"type": "number", "minimum": 0, "maximum": 24},
                  "mix_percent": {"type": "number", "minimum": 0, "maximum": 100},
                  "output_gain_db": {"type": "number", "minimum": -24, "maximum": 24},
                  "rationale": {"type": "string"},
                  "evidence": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["operation", "target", "bypassed"],
            "additionalProperties": false,
            "properties": {
              "operation": {"const": "bypass"},
              "target": {"enum": ["pro_q4", "pro_c3"]},
              "bypassed": {"type": "boolean"}
            }
          }
        ]
      }
    },
    "expected_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "direction", "maximum_delta", "unit"],
        "additionalProperties": false,
        "properties": {
          "metric": {"type": "string"},
          "direction": {"type": "string"},
          "maximum_delta": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "cautions": {"type": "array", "items": {"type": "string"}}
  }
}
