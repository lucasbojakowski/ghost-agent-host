muteTrack(int index, (int value* = -1), (int inGroup** = 0)) -> None
  Arguments: int index, (int value* = -1), (int inGroup** = 0)
  Returns: -
  Description: Toggle whether the track at index is muted. An unmuted track will become muted and a muted track will become unmuted. Set optional value to 1(mute) or to 0(unmute) track. Set optional 'inGroup' to 1 to mute/unmute track group (alt + click in FL)
  API version: 1, *30, *33

muteTrackLock(int index) -> None
  Arguments: int index
  Returns: -
  Description: Toggles the Mute lock status of the track at "index".
  API version: 2

refreshLiveClips(int index, int value) -> None
  Arguments: int index, int value
  Returns: -
  Description: Refresh live clips for track at "index".
  API version: 1

selectAll() -> None
  Arguments: -
  Returns: -
  Description: Select all playlist tracks.
  API version: 12

selectTool(int index) -> 
  Arguments: int index
  Returns: 
  Description: Select playlist/piano roll tool
  API version: 40

selectTrack(int index) -> None
  Arguments: int index
  Returns: -
  Description: Toggle selection of the track at "index".
  API version: 12

setTrackColor(int index, int color) -> None
  Arguments: int index, int color
  Returns: -
  Description: Changes the color of the track at "index" to the value of "color".
  API version: 1

setTrackName(int index, string name) -> None
  Arguments: int index, string name
  Returns: -
  Description: Changes the name of the track at "index" to "name".
  API version: 1

soloTrack(int index, (int value = -1), (int inGroup* = 0)) -> None
  Arguments: int index, (int value = -1), (int inGroup* = 0)
  Returns: -
  Description: Toggles the solo state of the track at "index". Set optional 'value' to 1 to solo the track, or 0 to unsolo it. Set optional 'inGroup' to 1 to solo/unsolo the track group (Alt + Right-click in FL Studio).
  API version: 1, *30

triggerLiveClip(int index, int blockNum, int flags , (float velocity = -1)) -> None
  Arguments: int index, int blockNum, int flags , (float velocity = -1)
  Returns: -
  Description: Trigger live clip for track at "index" and for block "blockNum". Set blockNum to -1 and use the TLC_Fill flag to stop live clips on this track.
  API version: 1

