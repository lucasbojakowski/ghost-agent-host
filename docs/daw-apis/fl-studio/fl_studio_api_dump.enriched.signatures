MODULE: arrangement

addAutoTimeMarker(int time, string name) -> None
  Arguments: int time, string name
  Returns: -
  Description: Add an automatic time marker at "time" with its name set to "name"
  API version: 1

currentTime(int snap) -> int
  Arguments: int snap
  Returns: int
  Description: Returns the current time in the current arrangement - set "snap" to True, to get returned value snapped to the grid.
  API version: 1

currentTimeHint(int mode, int time, (int setRecPPB = ), (int isLength = 0)) -> string
  Arguments: int mode, int time, (int setRecPPB = ), (int isLength = 0)
  Returns: string
  Description: Returns a hint string for the requested "time" in the current arrangement - "mode" is 0 for pattern mode and 1 for song mode.
  API version: 1

getMarkerName(int index) -> string
  Arguments: int index
  Returns: string
  Description: Returns the name of the requested marker - If the marker doesn't exist, an empty string is returned.
  API version: 1

jumpToMarker(int delta, int select) -> None
  Arguments: int delta, int select
  Returns: -
  Description: Select a marker - set "delta" to -1, to select the previous marker or to +1 to select the next marker - set "select" to True to select marker as well.
  API version: 1

liveSelection(int time, int stop) -> None
  Arguments: int time, int stop
  Returns: -
  Description: Set a live selection point at "time" - set "stop" to True, to use end point of the selection (instead of start).
  API version: 1

liveSelectionStart() -> int
  Arguments: -
  Returns: int
  Description: Returns the start time of the current live selection.
  API version: 1

selectionEnd() -> int
  Arguments: -
  Returns: int
  Description: Returns the end time of the current selection in the current arrangement.
  API version: 1

selectionStart() -> int
  Arguments: -
  Returns: int
  Description: Returns the start time of the current selection in the current arrangement.
  API version: 1

