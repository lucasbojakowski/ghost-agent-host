createRefreshThread() -> None
  Arguments: -
  Returns: -
  Description: Start a threaded refresh of the entire MIDI device.
  API version: 1

destroyRefreshThread() -> None
  Arguments: -
  Returns: -
  Description: Stop a previously started threaded refresh.
  API version: 1

directFeedback(eventData) -> None
  Arguments: eventData
  Returns: -
  Description: Send a received message on to the (linked) output interface - use this function inside OnMidiMsg and pass (modified) eventData object as function parameter
  API version: 1

dispatch(int ctrlIndex, int message, (bytes sysex)) -> None
  Arguments: int ctrlIndex, int message, (bytes sysex)
  Returns: -
  Description: Dispatch midi message (or sysex) to controller specified by ctrlIndex - receiver (script) must define sender(s) inside script: # receiveFrom="Sender name"
  API version: 1

dispatchGetReceiverPortNumber(int ctrlIndex) -> int
  Arguments: int ctrlIndex
  Returns: int
  Description: Returns port number of receiver specified by ctrlIndex.
  API version: 5

dispatchReceiverCount() -> int
  Arguments: -
  Returns: int
  Description: Returns number of available receivers.
  API version: 1

findEventID(int controlId, (int flags = [])) -> int
  Arguments: int controlId, (int flags = [])
  Returns: int
  Description: Returns eventID for controlId or REC_InvalidID when nothing is linked to this control "flags" can be one of the: FEID_Flags_Skip_Unsafe = 1 (skip unsafe (using formula) links)
  API version: 1

forwardMIDICC(int message, (int forwardTo = 1)) -> None
  Arguments: int message, (int forwardTo = 1)
  Returns: -
  Description: Forward CC message to plugin - Use this function to forward midi cc messages to FL plugin(s) - Specify message as: message = status + (data1 << 8) + (data2 << 16) + (port << 24) Message will be forwarded to active (focused) plugin - Use optional forwardTo parameter to send message to selected channel (forwardTo = 2) or to all plugins (0) - Remark: midi input port of plugin must be equal to port specified in message.
  API version: 7

fullRefresh() -> None
  Arguments: -
  Returns: -
  Description: Trigger a previously started threaded refresh - If there is none, the refresh is triggered immediately.
  API version: 1

getDeviceID() -> bytes
  Arguments: 
  Returns: bytes
  Description: Returns the ID of the device, which is the identifying component of its response to a universal device enquiry Sysex message. Note that this does not include the Sysex header (0xF0, 0x7E, 0x01, 0x06, 0x02), or the ending byte (0xF7). Also note that for many devices, it will also contain the firmware version, meaning that you should may wish to ignore the final 4 bytes of the response.
  API version: 25

getLinkedChannel(int eventID) -> int
  Arguments: int eventID
  Returns: int
  Description: Returns MIDI channel number for linked control via eventID (to get control eventId, use findEventID function) - Result is -1 if there is no linked control.
  API version: 27

getLinkedInfo(int eventID) -> int
  Arguments: int eventID
  Returns: int
  Description: Returns information about the linked control via eventID (to get control eventId, use findEventID function) - Result is -1 if there is no linked control, otherwise result is one or more of the constants
  API version: 1

getLinkedParamName(int eventID) -> string
  Arguments: int eventID
  Returns: string
  Description: Returns parameter name of the control linked via eventID (to get control eventId, use findEventID function) - Result is ERR_PLUGINNOTVALID if there is no linked control.
  API version: 10

getLinkedValue(int eventID) -> float
  Arguments: int eventID
  Returns: float
  Description: Returns normalized value of the linked control via eventID (to get control eventId, use findEventID function) - Result is -1 if there is no linked control.
  API version: 1

getLinkedValueString(int eventID) -> string
  Arguments: int eventID
  Returns: string
  Description: Returns text value of linked control via eventID (to get control eventId, use findEventID function) - Result is ERR_PLUGINNOTVALID if there is no linked control.
  API version: 10

getMasterSync() -> int
  Arguments: -
  Returns: int
  Description: Returns 'send master synch' state for current device (1 = enableb)
  API version: 19

getName() -> int
  Arguments: -
  Returns: int
  Description: Returns the device name
  API version: 7

