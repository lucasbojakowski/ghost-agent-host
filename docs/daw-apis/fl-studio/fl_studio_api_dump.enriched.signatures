  Description: Jump to a marker position - "value" is an increment.
  API version: 1

markerSelJog(int value, (int flags = GT_All)) -> None
  Arguments: int value, (int flags = GT_All)
  Returns: -
  Description: Select a marker - "value" is an increment.
  API version: 1

record() -> None
  Arguments: -
  Returns: -
  Description: Toggle recording.
  API version: 1

rewind(int startStop , (int flags = GT_All)) -> None
  Arguments: int startStop , (int flags = GT_All)
  Returns: -
  Description: Rewind the song position - Each call to this function with startStop = SS_Start, must be stopped with startStop = SS_Stop
  API version: 1

setLoopMode() -> None
  Arguments: -
  Returns: -
  Description: Toggle loop mode.
  API version: 1

setPlaybackSpeed(float speedMultiplier) -> None
  Arguments: float speedMultiplier
  Returns: -
  Description: Set a playback speed multiplier - Set speedMultiplier = (1) is normal speed, set to value between (1/4 ... 1) for slower and between (1 ... 4) faster movement
  API version: 1

setSongPos(float position, (int mode * = -1)) -> None
  Arguments: float position, (int mode * = -1)
  Returns: -
  Description: Set the song position - "position" is a normalized value (0..1) - or in specified format when mode* is set
