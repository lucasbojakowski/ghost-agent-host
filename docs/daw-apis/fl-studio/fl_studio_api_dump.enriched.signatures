MODULE: plugins

getColor(int index, (int slotIndex = -1), (int flag = GC_BackgroundColor), (int paramIndex = 0), (bool useGlobalIndex* = False)) -> int
  Arguments: int index, (int slotIndex = -1), (int flag = GC_BackgroundColor), (int paramIndex = 0), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns various plugin color parameter values for plugin at position of index/slotindex
  API version: 12, *26

getName(int index, (int slotIndex = -1), (int flag = FPN_Param), (int paramIndex = 0), (bool useGlobalIndex* = False)) -> string
  Arguments: int index, (int slotIndex = -1), (int flag = FPN_Param), (int paramIndex = 0), (bool useGlobalIndex* = False)
  Returns: string
  Description: Returns various plugin name parameter values for plugin at position of index/slotindex optional paramIndex depends on flag
  API version: 13, *26

getPadInfo(int index, (int slotIndex), (int paramOption ), (int paramIndex), (bool useGlobalIndex* = False)) -> int
  Arguments: int index, (int slotIndex), (int paramOption ), (int paramIndex), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns pad parameters for plugin at position of index/slotindex use PAD_Count as paramOption to get number of pad parameters supported by plugin
  API version: 19, *26

getParamCount(int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> int
  Arguments: int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns plugin parameter count for plugin at position of index/slotindex
  API version: 8, *26

getParamName(int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> string
  Arguments: int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: string
  Description: Returns plugin parameter (paramIndex) name for plugin at position of index/slotindex
  API version: 8, *26

getParamValue(int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> int
  Arguments: int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns plugin parameter (paramIndex) value for plugin at position of index/slotindex as normalized value
  API version: 8, *26

getParamValueString(int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> string
  Arguments: int paramIndex, int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: string
  Description: Returns plugin parameter (paramIndex) value as string for plugin at position of index/slotindex this function is only supported by some of the plugins, support for more plugins will be added later
  API version: 8, *26

getPluginName(int index, (int slotIndex = -1), (int userName* = 0), (bool useGlobalIndex** = False)) -> string
  Arguments: int index, (int slotIndex = -1), (int userName* = 0), (bool useGlobalIndex** = False)
  Returns: string
  Description: Returns plugin name for plugin at position of index/slotindex - Set optional userName parameter to 1 to get user name for plugin slot instead of original plugin name (will return plugin name if user didn't change name for slot)
  API version: 8, *12, **26

getPresetCount(int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> int
  Arguments: int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns number of presets for plugin at position of index/slotindex
  API version: 15, *26

isValid(int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> int
  Arguments: int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: int
  Description: Returns true if there is valid plugin at position of index/slotindex
  API version: 8, *26

nextPreset(int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> None
  Arguments: int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: -
  Description: Navigate to next preset in plugin at position of index/slotindex
  API version: 10, *26

prevPreset(int index, (int slotIndex = -1), (bool useGlobalIndex* = False)) -> None
  Arguments: int index, (int slotIndex = -1), (bool useGlobalIndex* = False)
  Returns: -
  Description: Navigate to previous preset in plugin at position of index/slotindex
  API version: 10, *26

setParamValue(float value, int paramIndex, int index, (int slotIndex = -1), (int pickupMode * = PIM_None), (bool useGlobalIndex** = False)) -> int
  Arguments: float value, int paramIndex, int index, (int slotIndex = -1), (int pickupMode * = PIM_None), (bool useGlobalIndex** = False)
  Returns: int
  Description: Sets value (normalized) for plugin parameter (paramIndex) for plugin at position of index/slotindex use optional pickupMode to override FL default pickup option
  API version: 8, *17, **26

==============================================================================
MODULE: transport

continuousMove(int speed, int startStop) -> None
  Arguments: int speed, int startStop
  Returns: -
  Description: Start Continuous move - This function do same as rewind and fastforward but you can control speed. Set speed (> 0) to move forward and (< 0) to move backward (speed = (1) is normal speed forward) Each call to this function with startStop = SS_Start, must be stopped with startStop = SS_Stop
  API version: 1

continuousMovePos(int speed, int startStop) -> None
  Arguments: int speed, int startStop
  Returns: -
  Description: Start Continuous move - Set speed (> 0) to move forward and (< 0) to move backward (speed = (1) is normal speed forward). Set startStop to (2) to start and to (0) to stop
  API version: 2

fastForward(int speed) -> None
  Arguments: int speed
  Returns: -
  Description: Forward the song position
  API version: 1

getHWBeatLEDState() -> int
  Arguments: -
  Returns: int
  Description: Returns the state of the hardware LED beat indicator.
  API version: 1

getLoopMode() -> int
  Arguments: -
  Returns: int
  Description: Returns the current looping mode (pattern = 0, song = 1).
  API version: 1

getSongLength(int mode) -> int
  Arguments: int mode
  Returns: int
  Description: Get the song length.
  API version: 3

getSongPos((int mode * = -1)) -> float
  Arguments: (int mode * = -1)
  Returns: float
  Description: Returns the song position as a normalized value (0..1) - or in specified format when mode* is set
  API version: 1, *3

getSongPosHint() -> string
  Arguments: -
  Returns: string
  Description: Returns a hint for the current song position.
  API version: 1

globalTransport(int command , int value, (int pmeflags = PME_System), (int flags = GT_ALL)) -> int
  Arguments: int command , int value, (int pmeflags = PME_System), (int flags = GT_ALL)
  Returns: int
  Description: Call the GlobalTransport function with the appropriate parameters - Use this function inside one of the eventData script events and pass eventData.pmeflags as "pmeflags" parameter
  API version: 1

isPlaying() -> int
  Arguments: -
  Returns: int
  Description: Returns True if the program is playing.
  API version: 1

isRecording() -> int
  Arguments: -
  Returns: int
  Description: Returns True when recording is active.
  API version: 1

markerJumpJog(int value, (int flags = GT_All)) -> None
  Arguments: int value, (int flags = GT_All)
